{
  "name": "@nymrel/agent-surety",
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-dependency execution firewall, path sandbox, command interceptor, and cryptographic audit ledger for AI coding agents and autonomous tool-calling swarms.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "agent-surety": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "node --test tests/ts/*.test.js",
    "test": "npm run build && npm run test:unit",
    "lint": "tsc --noEmit",
    "release:verify": "node scripts/verify-release.mjs",
    "check": "npm run build && npm run test:unit && npm run release:verify",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check && npm run audit && npm run audit:prod"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/agent-action-surety.git"
  },
  "keywords": [
    "ai-agent",
    "security",
    "execution-firewall",
    "sandbox",
    "command-interceptor",
    "audit-ledger",
    "merkle-chain",
    "machine-trust",
    "nymrel",
    "jalenbuilds",
    "zero-dependency"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.22.2 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nymrel/agent-action-surety#readme",
  "bugs": {
    "url": "https://github.com/nymrel/agent-action-surety/issues"
  }
}
